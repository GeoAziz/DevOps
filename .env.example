# Environment Variables
# Copy this file to .env.local and fill in the actual values

# Analytics
VITE_VERCEL_ANALYTICS_ID=your_vercel_analytics_id_here

# Contact Form (if using external service)
VITE_CONTACT_SERVICE_KEY=your_service_key_here

# Social Links
VITE_GITHUB_URL=https://github.com/neerajnakka
VITE_LINKEDIN_URL=https://linkedin.com/in/neerajnakka
VITE_TWITTER_URL=https://twitter.com/neerajnakka

# API Endpoints (if needed)
VITE_API_BASE_URL=http://localhost:3000

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_CONTACT_FORM=true
